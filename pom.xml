<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.ecomdemo</groupId>
	<artifactId>ecomdemo</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>ecomdemo</name>
	<description>Learning project: e-commerce monolith evolving into a distributed system</description>
	<properties>
		<java.version>21</java.version>
		<springdoc.version>3.1.1</springdoc.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!--
			springdoc-openapi scans the controllers at startup, builds an OpenAPI 3 document from
			the mappings, the DTO records and the Bean Validation constraints, serves it at
			/v3/api-docs and bundles Swagger UI to render it. 3.1.1 is the first GA line built
			against Spring Boot 4 / Spring Framework 7; the 2.x line targets Boot 3.
		-->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<!--
			The PostgreSQL JDBC driver. It is only ever loaded by reflection through the JDBC URL,
			so runtime scope is enough - no application code imports it. The version comes from
			the Spring Boot BOM, which pins a driver known to work with the managed HikariCP.
		-->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
			Flyway. On startup it scans classpath:db/migration, works out from its own
			`flyway_schema_history` table which versioned scripts this database has not run yet,
			and applies them in order, each inside a transaction.

			Two artifacts, for two different reasons:

			* `spring-boot-starter-flyway` brings `flyway-core` AND Spring Boot's Flyway
			  auto-configuration. Spring Boot 4 split auto-configuration out of one fat jar into
			  a module per technology, so - unlike Boot 3 - putting `flyway-core` on the
			  classpath by itself wires up nothing at all: the migrations are simply never run
			  and the application starts against whatever schema it happens to find.
			* Since Flyway 10, each database engine lives in its own module, so
			  `flyway-database-postgresql` carries the PostgreSQL dialect. (H2, which the test
			  suite uses, is one of the two still bundled inside flyway-core.)

			Both versions come from the Spring Boot BOM, so they match each other and the driver.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!--
			H2 stays, but only on the test classpath. The application now speaks to a real
			PostgreSQL server; the test suite still runs against an in-memory H2 so that
			`./mvnw clean verify` needs nothing installed. Phase 7 (Testcontainers) is where the
			tests move onto real PostgreSQL and this dependency finally goes.
		-->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!--
				Resolves dependency coordinates into properties, so that the surefire
				configuration below can point at the mockito-core jar in the local repository
				without hard-coding a path or a version.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>properties</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!--
				Mockito rewrites bytecode to build mocks, which needs a Java agent. Left alone it
				attaches one to the running JVM at the first mock, and recent JDKs warn that
				self-attaching will stop working; a future JDK will refuse it outright and the
				whole unit-test suite would fail. Loading the agent up front on the command line
				is the supported way to do it, and it silences the warning today.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>-javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
					<!--
						Activate the `test` profile for every test JVM, so the suite reads
						src/test/resources/application-test.properties and talks to H2 instead of
						the PostgreSQL server the `dev` profile points at. A system property beats
						the spring.profiles.active=dev written in application.properties.

						Setting it here rather than in src/test/resources/application.properties is
						deliberate: a file of that name on the test classpath SHADOWS the main one
						instead of adding to it, and every shared setting in it would be lost.
					-->
					<systemPropertyVariables>
						<spring.profiles.active>test</spring.profiles.active>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
