<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.ecomdemo</groupId>
	<artifactId>ecomdemo</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>ecomdemo</name>
	<description>Learning project: e-commerce monolith evolving into a distributed system</description>
	<properties>
		<java.version>21</java.version>
		<springdoc.version>3.1.1</springdoc.version>

		<!--
			JaCoCo is not managed by the Spring Boot parent, so the version is pinned here.
			0.8.15 is the current line and the first few to understand Java 21's class file
			format; an older one fails to instrument rather than quietly under-reporting.
		-->
		<jacoco.version>0.8.15</jacoco.version>
		<sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>

		<!--
			Empty defaults. The JaCoCo executions below fill these in, and Surefire and Failsafe
			read them with @{...} late evaluation. Without a default here, a build run with
			-Djacoco.skip=true would put the literal string "@{jacocoUnitArgLine}" on the command
			line and fail to start the JVM.
		-->
		<jacocoUnitArgLine></jacocoUnitArgLine>
		<jacocoItArgLine></jacocoItArgLine>

		<!--
			Where the scanner looks for coverage. It is the MERGED report, so Sonar counts a line
			as covered whether a unit test or an integration test reached it. Pointing this at
			only the unit report is the usual way a project reports a coverage number that is
			quietly wrong.
		-->
		<sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco-merged/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>

		<!--
			Generated code and configuration-only classes are excluded from coverage, not from
			analysis: Sonar still reports bugs and smells in them. `EcomdemoApplication` is a
			main method Spring Boot generates the body of, and the dto records are data carriers
			whose accessors are compiler-generated - "covering" either measures nothing.
		-->
		<sonar.coverage.exclusions>
			**/EcomdemoApplication.java,
			**/dto/**
		</sonar.coverage.exclusions>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!--
			springdoc-openapi scans the controllers at startup, builds an OpenAPI 3 document from
			the mappings, the DTO records and the Bean Validation constraints, serves it at
			/v3/api-docs and bundles Swagger UI to render it. 3.1.1 is the first GA line built
			against Spring Boot 4 / Spring Framework 7; the 2.x line targets Boot 3.
		-->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<!--
			Spring Security. Adding this one starter changes the application before a line of
			our code runs: it registers a servlet Filter that sits in front of every request,
			and its auto-configuration locks the whole application down by default. That default
			is the point — a new endpoint added in a later phase is protected until somebody
			deliberately opens it, rather than public until somebody remembers to close it.
			`SecurityConfig` replaces the defaults with this application's own rules.

			It also brings `spring-security-crypto`, which is where BCryptPasswordEncoder lives,
			so password hashing needs no separate dependency. The version comes from the Spring
			Boot BOM (Spring Security 7.x for Boot 4.x).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!--
			Spring Cache plus Redis.

			`spring-boot-starter-cache` is the abstraction: @Cacheable and friends, and the
			proxying that makes them work. It does nothing on its own - with no cache provider on
			the classpath Spring falls back to a ConcurrentHashMap, which is a cache per JVM and
			therefore no cache at all once there are two instances.

			`spring-boot-starter-data-redis` supplies the provider. It brings Lettuce, the default
			Redis client since Boot 2 (netty-based, non-blocking, and one connection is safe to
			share across threads - Jedis needed a pool). Versions come from the Spring Boot BOM.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-cache</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!--
			Spring Security's OAuth2 Resource Server. "Resource server" is the OAuth2 word for
			an API that ACCEPTS tokens rather than one that issues them: it adds a filter that
			pulls a Bearer token off the Authorization header, verifies its signature and its
			expiry, and turns the claims into an Authentication. All of that used to be the job
			of BasicAuthenticationFilter plus a database lookup on every request.

			Strictly, this application is both halves — it also ISSUES the token, at
			/api/auth/login — which a textbook OAuth2 deployment would split into a separate
			authorization server. That is the honest simplification of this phase, and the README
			says so. The starter brings `spring-security-oauth2-jose` with it, which carries
			Nimbus JOSE and therefore both the decoder AND the encoder, so signing needs no
			further dependency (and in particular no third-party JWT library).

			The version comes from the Spring Boot BOM (Spring Security 7.1.1).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>

		<!--
			The PostgreSQL JDBC driver. It is only ever loaded by reflection through the JDBC URL,
			so runtime scope is enough - no application code imports it. The version comes from
			the Spring Boot BOM, which pins a driver known to work with the managed HikariCP.
		-->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
			Flyway. On startup it scans classpath:db/migration, works out from its own
			`flyway_schema_history` table which versioned scripts this database has not run yet,
			and applies them in order, each inside a transaction.

			Two artifacts, for two different reasons:

			* `spring-boot-starter-flyway` brings `flyway-core` AND Spring Boot's Flyway
			  auto-configuration. Spring Boot 4 split auto-configuration out of one fat jar into
			  a module per technology, so - unlike Boot 3 - putting `flyway-core` on the
			  classpath by itself wires up nothing at all: the migrations are simply never run
			  and the application starts against whatever schema it happens to find.
			* Since Flyway 10, each database engine lives in its own module, so
			  `flyway-database-postgresql` carries the PostgreSQL dialect. (H2, which the test
			  suite uses, is one of the two still bundled inside flyway-core.)

			Both versions come from the Spring Boot BOM, so they match each other and the driver.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!--
			H2, on the test classpath only. Phase 7 was pencilled in as the phase that would
			delete it; it stays, and that is a deliberate choice rather than an oversight.

			The two suites now answer two different questions. The unit and slice tests
			(Surefire, `test` profile, H2) ask "is the Java right?" - they run in seconds, on any
			machine, with no Docker, and they are what a developer runs constantly. The
			integration tests (Failsafe, `it` profile, Testcontainers) ask "is this true of
			PostgreSQL?" - they cost a container start and they are where an H2-only truth would
			be caught. Deleting H2 would buy honesty in the fast suite at the price of making it
			slow, which is the trade the testing pyramid exists to avoid.
		-->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			`spring-security-test`, by way of Boot 4's starter. It contributes @WithMockUser and
			the SecurityMockMvcRequestPostProcessors that let a slice test say "run this request
			as an ADMIN" without a real login, and it is what makes the 401/403 assertions in the
			controller tests possible at all — a @WebMvcTest builds the security filter chain,
			so without an authenticated user every request in those tests would simply be a 401.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			Testcontainers. `testcontainers-postgresql` starts a real PostgreSQL server in a
			Docker container for the duration of the tests and throws it away afterwards, so the
			integration tests run against the same engine production uses instead of an H2
			imitation of it. In Testcontainers 2.x every database module is named
			`testcontainers-<engine>`; the 1.x coordinates were `org.testcontainers:postgresql`.

			`spring-boot-testcontainers` is the bridge: it is what makes @ServiceConnection work,
			so a container declared as a @Bean supplies the JDBC url, username and password to
			the application context by itself. Without it the container would start and the test
			would still connect to whatever spring.datasource.url happened to say.

			There is deliberately no `testcontainers-junit-jupiter`: its @Testcontainers/@Container
			extension is the alternative to letting Spring own the container lifecycle, and this
			phase lets Spring own it (see PostgresContainerConfig).

			Versions come from the Spring Boot BOM (testcontainers 2.0.5).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			`TestRestTemplate` - the client the integration tests use to call the running
			application - is a thin wrapper over `RestTemplate`, and it builds one through
			`RestTemplateBuilder`. Spring Boot 4 moved that builder into its own
			`spring-boot-restclient` module, and this application never makes an outbound HTTP
			call, so nothing else drags it in: without this line the context fails to start with
			`ClassNotFoundException: org.springframework.boot.restclient.RestTemplateBuilder`.
			Test scope, because it is the test client that needs it and not the application.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-restclient</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!--
				Resolves dependency coordinates into properties, so that the surefire
				configuration below can point at the mockito-core jar in the local repository
				without hard-coding a path or a version.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>properties</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!--
				Mockito rewrites bytecode to build mocks, which needs a Java agent. Left alone it
				attaches one to the running JVM at the first mock, and recent JDKs warn that
				self-attaching will stop working; a future JDK will refuse it outright and the
				whole unit-test suite would fail. Loading the agent up front on the command line
				is the supported way to do it, and it silences the warning today.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!--
						@{jacocoUnitArgLine} rather than ${...}: the @ form is Surefire's LATE
						evaluation, resolved when the test JVM is forked rather than when the pom
						is read. JaCoCo sets the property during the build, so the ${...} form
						would expand to the empty default it had at parse time and no coverage
						would be recorded - a silent failure that looks like 0% coverage.
					-->
					<argLine>@{jacocoUnitArgLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
					<!--
						Activate the `test` profile for every test JVM, so the suite reads
						src/test/resources/application-test.properties and talks to H2 instead of
						the PostgreSQL server the `dev` profile points at. A system property beats
						the spring.profiles.active=dev written in application.properties.

						Setting it here rather than in src/test/resources/application.properties is
						deliberate: a file of that name on the test classpath SHADOWS the main one
						instead of adding to it, and every shared setting in it would be lost.
					-->
					<systemPropertyVariables>
						<spring.profiles.active>test</spring.profiles.active>
					</systemPropertyVariables>
				</configuration>
			</plugin>

			<!--
				Failsafe runs the integration tests. It is a separate plugin from Surefire, and
				the split is not cosmetic:

				* WHAT THEY RUN. The two plugins have different default file patterns and they do
				  not overlap. Surefire takes `*Test.java` / `Test*.java` / `*Tests.java`;
				  Failsafe takes `*IT.java` / `IT*.java` / `*ITCase.java`. Naming a class
				  `SomethingIT` is therefore the entire mechanism by which it moves from the fast
				  suite to the slow one - there is no annotation and no tag to remember.

				* WHEN THEY RUN. Surefire runs at the `test` phase, BEFORE the jar is built, and
				  a failure stops the build there. Failsafe runs at `integration-test`, after
				  `package`, and - this is the point of the name - it does NOT fail the build
				  when a test fails. It records the result and lets the build continue to
				  `post-integration-test`, so that whatever a real integration test started
				  (here a container; in other projects a server, a queue, a leased database) is
				  always torn down. The separate `verify` goal below then reads those recorded
				  results and fails the build. Bind only `integration-test` and a broken test is
				  silently green.

				`./mvnw test` now means "the fast suite"; `./mvnw verify` means both. Docker must
				be running for the second.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<!--
						The same Java agent Surefire gets. No integration test mocks anything,
						but spring-test's MockitoTestExecutionListener runs for every test and
						touches Mockito, which then self-attaches an agent and prints the "this
						will no longer work in future releases of the JDK" warning. Loading it on
						the command line is the supported way and keeps this JVM behaving like
						the Surefire one.
					-->
					<argLine>@{jacocoItArgLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!--
				JaCoCo measures which lines the tests actually executed, by instrumenting classes
				as the JVM loads them.

				It is declared AFTER Failsafe on purpose. Plugin executions bound to the same
				phase run in the order they appear here, and the merge and report below are bound
				to `verify` - the same phase as `failsafe:verify`. Declared earlier, they would
				merge and report the integration coverage before the integration tests had
				finished writing it.

				WHY TWO AGENTS AND A MERGE. Surefire and Failsafe fork separate JVMs, so each
				needs its own agent and writes its own exec file. A single `prepare-agent` would
				instrument only the unit run, and the coverage number would silently count the
				fast suite alone - which for this project would badly understate it, since the
				*IT tests are the only ones that exercise the controllers over real HTTP.
			-->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>

					<!-- Unit and slice tests (Surefire). Binds to `initialize` by default. -->
					<execution>
						<id>prepare-agent-unit</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
						<configuration>
							<destFile>${project.build.directory}/jacoco-unit.exec</destFile>
							<propertyName>jacocoUnitArgLine</propertyName>
						</configuration>
					</execution>

					<!-- Integration tests (Failsafe). Binds to `pre-integration-test`. -->
					<execution>
						<id>prepare-agent-it</id>
						<goals>
							<goal>prepare-agent-integration</goal>
						</goals>
						<configuration>
							<destFile>${project.build.directory}/jacoco-it.exec</destFile>
							<propertyName>jacocoItArgLine</propertyName>
						</configuration>
					</execution>

					<!--
						One file from the two runs. `fileset` rather than naming the two files so
						that a build which ran only `./mvnw test` still merges cleanly - there is
						simply one file to merge, and the report then honestly shows unit
						coverage only.
					-->
					<execution>
						<id>merge-coverage</id>
						<phase>verify</phase>
						<goals>
							<goal>merge</goal>
						</goals>
						<configuration>
							<fileSets>
								<fileSet>
									<directory>${project.build.directory}</directory>
									<includes>
										<include>jacoco-*.exec</include>
									</includes>
								</fileSet>
							</fileSets>
							<destFile>${project.build.directory}/jacoco-merged.exec</destFile>
						</configuration>
					</execution>

					<!--
						The human-readable report (HTML, open target/site/jacoco-merged/index.html)
						and the XML one the Sonar scanner reads.
					-->
					<execution>
						<id>report-coverage</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
						<configuration>
							<dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
							<outputDirectory>${project.build.directory}/site/jacoco-merged</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!--
				The Sonar scanner. Not bound to a phase: analysis is an explicit
				`./mvnw sonar:sonar` against a running SonarQube, never something that happens
				during an ordinary build. Pinned, because a scanner that changes under you
				changes what the quality gate sees.
			-->
			<plugin>
				<groupId>org.sonarsource.scanner.maven</groupId>
				<artifactId>sonar-maven-plugin</artifactId>
				<version>${sonar-maven-plugin.version}</version>
			</plugin>
		</plugins>
	</build>

</project>
