<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.ecomdemo</groupId>
	<artifactId>ecomdemo-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>ecomdemo-parent</name>
	<description>Learning project: e-commerce monolith evolving into a distributed system</description>

	<!--
		PHASE 20: the build becomes a REACTOR.

		Until now this was one POM producing one jar. The phase splits the application into services,
		and a service is a deployable - which in Maven means a module of its own. This POM builds
		nothing itself; it owns the versions, the properties and every plugin's configuration, and the
		modules below inherit them.

		`common` is a LIBRARY, not a service. It holds what several services genuinely share - the API
		error shape, the domain exceptions, the correlation-ID filter, the meter names - and it
		depends on no other module of this project. That is the property that makes it safe to be
		underneath everything else, and it was not free: `shared` used to import a constant from
		`security`, which was survivable inside one jar and a cycle Maven cannot resolve between two.

		`ecomdemo-app` is still the whole application, one deployable, exactly as it was. The services
		are carved out of it in the commits that follow; doing the build restructure first means each
		extraction is a move between existing modules rather than an invention of the module system
		at the same time.

		Every plugin lives in <pluginManagement>: a module gets a plugin by NAMING it, with no
		configuration of its own. That matters most for spring-boot-maven-plugin, which repackages a
		jar into an executable application - correct for a service, and a build failure for a library
		with no main class.
	-->
	<modules>
		<module>common</module>
		<module>ecomdemo-app</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<springdoc.version>3.1.1</springdoc.version>

		<!--
			JaCoCo is not managed by the Spring Boot parent, so the version is pinned here.
			0.8.15 is the current line and the first few to understand Java 21's class file
			format; an older one fails to instrument rather than quietly under-reporting.
		-->
		<jacoco.version>0.8.15</jacoco.version>

		<!--
			Pinned here because Spring Boot 4.1.1 does not manage Spring Modulith at all. See the
			dependency block below for why that is survivable: these jars are test-scoped and the
			application context is never built from them.
		-->
		<spring-modulith.version>1.4.1</spring-modulith.version>
		<sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>

		<!--
			Empty defaults. The JaCoCo executions below fill these in, and Surefire and Failsafe
			read them with @{...} late evaluation. Without a default here, a build run with
			-Djacoco.skip=true would put the literal string "@{jacocoUnitArgLine}" on the command
			line and fail to start the JVM.
		-->
		<jacocoUnitArgLine></jacocoUnitArgLine>
		<jacocoItArgLine></jacocoItArgLine>

		<!--
			Where the scanner looks for coverage. It is the MERGED report, so Sonar counts a line
			as covered whether a unit test or an integration test reached it. Pointing this at
			only the unit report is the usual way a project reports a coverage number that is
			quietly wrong.
		-->
		<sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco-merged/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>

		<!--
			Generated code and configuration-only classes are excluded from coverage, not from
			analysis: Sonar still reports bugs and smells in them. `EcomdemoApplication` is a
			main method Spring Boot generates the body of, and the dto records are data carriers
			whose accessors are compiler-generated - "covering" either measures nothing.
		-->
		<sonar.coverage.exclusions>
			**/EcomdemoApplication.java,
			**/dto/**
		</sonar.coverage.exclusions>
	</properties>

	<build>
			<pluginManagement>
				<plugins>
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
					<executions>
						<!--
						Writes target/classes/META-INF/build-info.properties at package time.
						Actuator turns that file into a BuildProperties bean, which is what makes
						/actuator/info report the artifact, version and build timestamp. Without
						this execution the info endpoint answers `{}` and there is no way to tell
						from a running container WHICH build is running - the first question
						anyone asks when a deployment behaves unexpectedly.
					-->
						<execution>
							<goals>
								<goal>build-info</goal>
							</goals>
						</execution>
					</executions>
				</plugin>

				<!--
				Resolves dependency coordinates into properties, so that the surefire
				configuration below can point at the mockito-core jar in the local repository
				without hard-coding a path or a version.
			-->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-dependency-plugin</artifactId>
					<executions>
						<execution>
							<goals>
								<goal>properties</goal>
							</goals>
						</execution>
					</executions>
				</plugin>

				<!--
				Mockito rewrites bytecode to build mocks, which needs a Java agent. Left alone it
				attaches one to the running JVM at the first mock, and recent JDKs warn that
				self-attaching will stop working; a future JDK will refuse it outright and the
				whole unit-test suite would fail. Loading the agent up front on the command line
				is the supported way to do it, and it silences the warning today.
			-->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<!--
						@{jacocoUnitArgLine} rather than ${...}: the @ form is Surefire's LATE
						evaluation, resolved when the test JVM is forked rather than when the pom
						is read. JaCoCo sets the property during the build, so the ${...} form
						would expand to the empty default it had at parse time and no coverage
						would be recorded - a silent failure that looks like 0% coverage.
					-->
						<argLine>@{jacocoUnitArgLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
						<!--
						Activate the `test` profile for every test JVM, so the suite reads
						src/test/resources/application-test.properties and talks to H2 instead of
						the PostgreSQL server the `dev` profile points at. A system property beats
						the spring.profiles.active=dev written in application.properties.

						Setting it here rather than in src/test/resources/application.properties is
						deliberate: a file of that name on the test classpath SHADOWS the main one
						instead of adding to it, and every shared setting in it would be lost.
					-->
						<systemPropertyVariables>
							<spring.profiles.active>test</spring.profiles.active>
						</systemPropertyVariables>
					</configuration>
				</plugin>

				<!--
				Failsafe runs the integration tests. It is a separate plugin from Surefire, and
				the split is not cosmetic:

				* WHAT THEY RUN. The two plugins have different default file patterns and they do
				  not overlap. Surefire takes `*Test.java` / `Test*.java` / `*Tests.java`;
				  Failsafe takes `*IT.java` / `IT*.java` / `*ITCase.java`. Naming a class
				  `SomethingIT` is therefore the entire mechanism by which it moves from the fast
				  suite to the slow one - there is no annotation and no tag to remember.

				* WHEN THEY RUN. Surefire runs at the `test` phase, BEFORE the jar is built, and
				  a failure stops the build there. Failsafe runs at `integration-test`, after
				  `package`, and - this is the point of the name - it does NOT fail the build
				  when a test fails. It records the result and lets the build continue to
				  `post-integration-test`, so that whatever a real integration test started
				  (here a container; in other projects a server, a queue, a leased database) is
				  always torn down. The separate `verify` goal below then reads those recorded
				  results and fails the build. Bind only `integration-test` and a broken test is
				  silently green.

				`./mvnw test` now means "the fast suite"; `./mvnw verify` means both. Docker must
				be running for the second.
			-->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-failsafe-plugin</artifactId>
					<configuration>
						<!--
						The same Java agent Surefire gets. No integration test mocks anything,
						but spring-test's MockitoTestExecutionListener runs for every test and
						touches Mockito, which then self-attaches an agent and prints the "this
						will no longer work in future releases of the JDK" warning. Loading it on
						the command line is the supported way and keeps this JVM behaving like
						the Surefire one.
					-->
						<argLine>@{jacocoItArgLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
					</configuration>
					<executions>
						<execution>
							<goals>
								<goal>integration-test</goal>
								<goal>verify</goal>
							</goals>
						</execution>
					</executions>
				</plugin>

				<!--
				JaCoCo measures which lines the tests actually executed, by instrumenting classes
				as the JVM loads them.

				It is declared AFTER Failsafe on purpose. Plugin executions bound to the same
				phase run in the order they appear here, and the merge and report below are bound
				to `verify` - the same phase as `failsafe:verify`. Declared earlier, they would
				merge and report the integration coverage before the integration tests had
				finished writing it.

				WHY TWO AGENTS AND A MERGE. Surefire and Failsafe fork separate JVMs, so each
				needs its own agent and writes its own exec file. A single `prepare-agent` would
				instrument only the unit run, and the coverage number would silently count the
				fast suite alone - which for this project would badly understate it, since the
				*IT tests are the only ones that exercise the controllers over real HTTP.
			-->
				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<version>${jacoco.version}</version>
					<executions>

						<!-- Unit and slice tests (Surefire). Binds to `initialize` by default. -->
						<execution>
							<id>prepare-agent-unit</id>
							<goals>
								<goal>prepare-agent</goal>
							</goals>
							<configuration>
								<destFile>${project.build.directory}/jacoco-unit.exec</destFile>
								<propertyName>jacocoUnitArgLine</propertyName>
							</configuration>
						</execution>

						<!-- Integration tests (Failsafe). Binds to `pre-integration-test`. -->
						<execution>
							<id>prepare-agent-it</id>
							<goals>
								<goal>prepare-agent-integration</goal>
							</goals>
							<configuration>
								<destFile>${project.build.directory}/jacoco-it.exec</destFile>
								<propertyName>jacocoItArgLine</propertyName>
							</configuration>
						</execution>

						<!--
						One file from the two runs. `fileset` rather than naming the two files so
						that a build which ran only `./mvnw test` still merges cleanly - there is
						simply one file to merge, and the report then honestly shows unit
						coverage only.
					-->
						<execution>
							<id>merge-coverage</id>
							<phase>verify</phase>
							<goals>
								<goal>merge</goal>
							</goals>
							<configuration>
								<fileSets>
									<fileSet>
										<directory>${project.build.directory}</directory>
										<includes>
											<include>jacoco-*.exec</include>
										</includes>
									</fileSet>
								</fileSets>
								<destFile>${project.build.directory}/jacoco-merged.exec</destFile>
							</configuration>
						</execution>

						<!--
						The human-readable report (HTML, open target/site/jacoco-merged/index.html)
						and the XML one the Sonar scanner reads.
					-->
						<execution>
							<id>report-coverage</id>
							<phase>verify</phase>
							<goals>
								<goal>report</goal>
							</goals>
							<configuration>
								<dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
								<outputDirectory>${project.build.directory}/site/jacoco-merged</outputDirectory>
							</configuration>
						</execution>
					</executions>
				</plugin>

				<!--
				The Sonar scanner. Not bound to a phase: analysis is an explicit
				`./mvnw sonar:sonar` against a running SonarQube, never something that happens
				during an ordinary build. Pinned, because a scanner that changes under you
				changes what the quality gate sees.
			-->
				<plugin>
					<groupId>org.sonarsource.scanner.maven</groupId>
					<artifactId>sonar-maven-plugin</artifactId>
					<version>${sonar-maven-plugin.version}</version>
				</plugin>
				</plugins>
			</pluginManagement>
	</build>

</project>
