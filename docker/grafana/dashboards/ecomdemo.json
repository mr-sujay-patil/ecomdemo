  },
  "description": "RED for checkout and HTTP, USE for the JVM underneath, and the business meters on top. Provisioned from docker/grafana/dashboards/ecomdemo.json - edits made in this UI are overwritten on reload.",
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Orders placed / min",
      "description": "rate() of the orders.placed counter, scaled to a minute. Never the raw counter: it only goes up, and it resets to zero when the process restarts.",
      "datasource": {
        "type": "prometheus",
        "uid": "ecomdemo-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ecomdemo-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(orders_placed_total{application=\"$application\"}[$__rate_interval])) * 60",
          "legendFormat": "orders/min",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Revenue (selected range)",
      "description": "The _sum side of the order.value summary. increase() over $__range makes this follow the time picker instead of being a number whose window nobody can remember.",
      "datasource": {
        "type": "prometheus",
        "uid": "ecomdemo-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
