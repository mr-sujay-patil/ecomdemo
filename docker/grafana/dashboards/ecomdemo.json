      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ecomdemo-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(checkout_duration_seconds_count{application=\"$application\", outcome!=\"placed\"}[$__rate_interval])) / sum(rate(checkout_duration_seconds_count{application=\"$application\"}[$__rate_interval]))",
          "legendFormat": "failed",
          "range": true,
          "refId": "A"
        }
      ]
    },
