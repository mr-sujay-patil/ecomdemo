# EcomDemo — local environment for `docker compose up`
#
#   cp .env.example .env
#
# .env is gitignored; this file is the documented template and must never contain a real secret.
# Compose reads .env automatically from the directory it runs in. Every value below has a
# working default in compose.yaml, so an empty .env starts a usable stack — the two worth
# setting deliberately are JWT_SECRET and POSTGRES_PASSWORD.

# --- The JWT signing key (Phase 9) -----------------------------------------------------------
# At least 32 characters: HS256 signs with a 256-bit key and the application refuses to start
# with less rather than padding it. Leave it unset and the application generates a random key
# per start and warns — fine for a quick look, but every token is invalidated by a restart.
#
# Generate one with:   openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters

# --- PostgreSQL -------------------------------------------------------------------------------
# The defaults are throwaway local credentials, the same ones the dev profile has used since
# Phase 4. Changing POSTGRES_PASSWORD after the volume exists does NOT change the password of a
# database that is already initialised: POSTGRES_PASSWORD only applies on first creation.
# `docker compose down -v` to start over.
POSTGRES_DB=ecomdemo
POSTGRES_USER=ecomdemo
POSTGRES_PASSWORD=ecomdemo

# Host port for the database. The application does not use this — it reaches PostgreSQL over the
# compose network — so change it freely if something else already owns 5432 locally.
POSTGRES_PORT=5432

# --- The application ---------------------------------------------------------------------------
# 8084 SINCE PHASE 21, and this line is why the gateway would not start.
#
# The gateway owns 8080 now - it is the only port a client needs. compose defaults this to 8084, but
# a value HERE overrides that default, so leaving 8080 in this file meant the application grabbed the
# port and the gateway container died with "port is already allocated". The failure was in an env file
# and the error message was about Docker networking.
#
# The container still listens on 8080 internally either way; only the host mapping changed. This port
# is for the WHITE-BOX checks - /actuator/health, the Prometheus scrape, a heapdump - which must reach
# the application rather than the gateway.
APP_PORT=8084

# The container's memory limit, and therefore what -XX:MaxRAMPercentage=50 is 50% of.
APP_MEMORY_LIMIT=1G

# Extra JVM flags. Overrides the Dockerfile default entirely, so repeat what you still want.
# JAVA_OPTS=-XX:MaxRAMPercentage=50.0 -XX:+ExitOnOutOfMemoryError -XX:+HeapDumpOnOutOfMemoryError

# --- The API gateway (Phase 21) -----------------------------------------------------------------
# The single door. This is the port clients use, and the port scripts/smoke-test.sh talks to.
GATEWAY_PORT=8080

# A gateway holds no database connections and no JPA metamodel - but a JVM's non-heap (~107 MiB
# here) is a fixed cost whatever the heap. 768M, like every service since the WSL2 workstation.
GATEWAY_MEMORY_LIMIT=768M

SPRING_PROFILES_ACTIVE=dev

# --- Monitoring (Phase 15) ---------------------------------------------------------------------
# Prometheus' web UI: the place to check that the `ecomdemo` target is UP (Status -> Targets) and
# to try a PromQL expression before putting it on a dashboard. 19090, not Prometheus' usual 9090:
# Windows reserves port ranges for Hyper-V/WinNAT, and 9090 has fallen inside one on this project's
# machine. Only the host side moves; inside the network Prometheus is still prometheus:9090.
PROMETHEUS_PORT=19090

# Grafana. The dashboard is provisioned from docker/grafana/dashboards/ecomdemo.json and is the
# home page, so http://localhost:3000 lands on it directly.
GRAFANA_PORT=3000

# Local-only credentials for a Grafana that is not reachable from outside this machine. Changing
# GRAFANA_PASSWORD after the grafana-data volume exists does NOT change the password of an admin
# user that is already created - same trap as POSTGRES_PASSWORD. `docker compose down -v` to
# start over.
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- Logging (Phase 16) ------------------------------------------------------------------------
# The console log format for the CONTAINER. `ecs` makes it JSON that Alloy can parse; unset (or
# empty) gives the human-readable pattern layout, which is what `./mvnw spring-boot:run` uses on a
# laptop. Setting this to an empty string here is a quick way to read `docker compose logs -f app`
# with your own eyes - at the cost of every field Loki extracts.
LOG_FORMAT=ecs

# Loki's API. Published for the smoke test and for curl; Grafana reaches it over the compose
# network instead.
#   curl -sG http://localhost:3100/loki/api/v1/query_range --data-urlencode 'query={service_name="app"}'
LOKI_PORT=3100

# Tempo's query API (Phase 23). Published for the smoke test and for curl; Grafana reaches it over
# the compose network instead.
#   curl -s http://localhost:3200/api/v2/traces/<trace-id>
TEMPO_PORT=3200

# The fraction of new traces that are recorded. 1.0 = all of them, which the smoke test needs.
TRACING_SAMPLING_PROBABILITY=1.0

# Grafana Alloy's own UI - a live view of the pipeline: which containers it discovered, how many
# lines it has shipped, and what it is failing to send. The first place to look when a log line
# does not show up in Grafana.
ALLOY_PORT=12345

# --- The language model (Phase 27) -----------------------------------------------------------
# Which chat model catalog-service uses for POST /api/products/{id}/generate-description:
#   none   - the default. The service starts and the endpoint answers 503 "not configured".
#   openai - hosted; needs OPENAI_API_KEY. Every call costs money (a few hundred tokens each).
#   ollama - free and local. Install Ollama on the host, then `ollama pull llama3.2`.
AI_CHAT_PROVIDER=none

# The model each provider uses. One variable per provider, because each has its own model names.
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_MODEL=llama3.2

# How long one generation may take before the endpoint gives up with a 503.
AI_TIMEOUT=30s

# Only for AI_CHAT_PROVIDER=openai. Set it in .env (gitignored) or your shell - never here.
OPENAI_API_KEY=

# Where catalog-service finds Ollama. The default reaches Ollama on the host from inside compose.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
