<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.ecomdemo</groupId>
		<artifactId>ecomdemo-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>gateway-service</artifactId>
	<name>gateway-service</name>
	<description>The single door clients knock on: routing, edge authentication, and rate limits</description>

	<!--
		THE ONLY REACTIVE MODULE IN THE REACTOR, and that is not a style preference.

		Spring Cloud Gateway's server is built on Netty and WebFlux because a gateway holds a great
		many mostly-idle connections at once - it spends its life waiting for someone else's
		response, which is the one workload where a thread per request is the wrong shape. The
		Redis rate limiter is a reactive filter for the same reason, and has no servlet equivalent.

		The consequence to remember: `ecomdemo-common` is shared, but its FILTERS and its security
		configuration are servlet code and do nothing here. This module scans only its own package
		(see GatewayApplication) and rebuilds those few pieces against the reactive API, reusing
		the SHARED CONSTANTS so that one contract does not acquire a second spelling at the edge.
	-->

	<dependencyManagement>
		<dependencies>
			<!--
				Declared here and not in the parent, deliberately: the parent has no
				dependencyManagement block at all today, and one module needing a BOM is not a
				reason for all six to consult it. Phase 22 may well move it up.
			-->
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!--
			The shared CONTRACTS - ApiError's shape, the correlation ID's spelling, the claim names,
			the JWT properties. It arrives here WITHOUT a servlet stack, by the exclusions below.
		-->
		<dependency>
			<groupId>com.ecomdemo</groupId>
			<artifactId>ecomdemo-common</artifactId>
			<version>${project.version}</version>
			<!--
				THE SERVLET STACK IS EXCLUDED, and without this the application does not start as a
				gateway at all.

				Boot chooses its web type from the classpath. With Tomcat and spring-webmvc present it
				builds a SERVLET context, Netty never starts, and Spring Cloud Gateway's server - which
				exists only for the reactive stack - is simply absent. The symptom is not an error; it
				is an application that comes up healthy and routes nothing.

				springdoc is excluded because it depends on the servlet starter and would drag it back
				in. Nothing here is lost: this service has no controllers to document.

				`common`'s own servlet classes remain on the classpath as bytecode - CorrelationIdFilter,
				ApiErrorWriter, the exception handler - and are never loaded, because
				GatewayApplication scans only `com.ecomdemo.gateway`. A class is loaded when something
				references it, and nothing here does.

				Excluding here rather than marking OPTIONAL in `common` is deliberate, and the reverse
				was tried: optional broke the other four services, whose component scan introspects
				`OpenApiConfig` and needs springdoc's types on the classpath to do it.
			-->
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-webmvc</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.springdoc</groupId>
					<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
		</dependency>

		<!--
			The rate limiter's store. REACTIVE Redis, and a different logical database from the
			catalogue cache - see application.yml.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis-reactive</artifactId>
		</dependency>

		<!--
			Validates tokens at the EDGE. Every service still validates the token it receives, so
			this is defence in depth rather than a transfer of responsibility: a misconfigured route
			must not be able to make a service unsafe.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>

		<dependency>
			<groupId>com.ecomdemo</groupId>
			<artifactId>ecomdemo-common</artifactId>
			<version>${project.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
			<!--
				THE SAME EXCLUSIONS AGAIN, and forgetting them here cost a confusing hour.
				
				Exclusions are per DEPENDENCY DECLARATION, not per artifact. The declaration above
				keeps the servlet stack out of the main classpath; this one is a second declaration of
				the same artifact and inherited nothing from it, so Tomcat and spring-webmvc arrived at
				TEST scope only.
				
				The consequence was not a missing class, it was the opposite: Boot saw a servlet
				container on the test classpath, built a SERVLET context, and the unconditional
				@EnableWebFluxSecurity then registered `conversionServicePostProcessor` a second time -
				a BeanDefinitionOverrideException naming two Spring Security classes and nothing of
				ours. The production jar was correct the whole time; only the tests ran against the
				wrong web stack.
				
				It also hid for a while behind the local repository: running this module alone resolved
				an EARLIER `common` from ~/.m2 whose starters were still optional, so the tests passed
				standalone and failed in the reactor. `./mvnw clean verify` on the whole reactor is the
				only build that told the truth.
			-->
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-webmvc</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.springdoc</groupId>
					<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			WebTestClient, the reactive counterpart of the webmvc-test starter every other module
			declares. `spring-boot-starter-test` alone does NOT auto-configure it, and the failure is
			a NoSuchBeanDefinitionException at injection time rather than anything that names the
			missing starter - the same shape of omission as the RestClient.Builder that kept
			catalog-service's container from starting in Phase 20c.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			A real Redis for the rate limiter's integration test. The limiter is a Lua script
			executed inside Redis; a mocked store would prove that the filter was wired and
			nothing about whether a burst is actually refused.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
			Testcontainers CORE only. `common`'s test-jar already declares the one Redis container
			this project uses (RedisContainerConfig, a GenericContainer with a @ServiceConnection
			name) - there is no Testcontainers module for Redis because an image and a port is all it
			needs. Reusing that class rather than starting a second Redis keeps the shared context
			cache key intact, which is the Phase 7 lesson.
		-->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
			</plugin>
			<!--
				NAMED, not assumed. The parent declares Failsafe in <pluginManagement>, so a module
				that does not name it runs no *IT tests and says nothing about it - which is exactly
				how four services' integration tests went unexecuted for two phases. See
				docs/test-reports/phase-20d.md section 0, and EveryModuleWithIntegrationTestsRunsThemTest,
				which now fails the build over this omission.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
